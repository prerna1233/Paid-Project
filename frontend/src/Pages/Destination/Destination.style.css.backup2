/* Modern Travel Website - Clean UI Architecture */

/* Reset & Base */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Inter', 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
  line-height: 1.6;
  color: #1a202c;
  background: #ffffff;
  font-weight: 400;
}

/* Container & Layout */
.destination-container {
  background: #ffffff;
  min-height: 100vh;
}

.container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 2rem;
}

/* Section Headers */
.section-header {
  text-align: center;
  margin-bottom: 4rem;
}

.section-title {
  font-size: 2.5rem;
  font-weight: 700;
  color: #1a202c;
  margin-bottom: 1rem;
  letter-spacing: -0.02em;
}

.section-subtitle {
  font-size: 1.1rem;
  color: #64748b;
  max-width: 600px;
  margin: 0 auto;
}

/* Hero Section */
.hero-section {
  position: relative;
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

.hero-background {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url('https://images.unsplash.com/photo-1506905925346-21bda4d32df4?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') center/cover;
  z-index: 1;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(40, 167, 69, 0.8) 0%, rgba(32, 201, 151, 0.6) 100%);
  z-index: 2;
}

.hero-content {
  position: relative;
  z-index: 3;
  flex: 1;
  display: flex;
  align-items: center;
  padding: 0 2rem;
}

.hero-text {
  color: white;
  max-width: 650px;
  margin: 4rem auto 0;
  text-align: center;
}

.hero-title {
  font-size: 4rem;
  font-weight: 800;
  margin-bottom: 1.5rem;
  line-height: 1.1;
  letter-spacing: -0.03em;
}

.hero-description {
  font-size: 1.2rem;
  line-height: 1.7;
  margin-bottom: 2.5rem;
  opacity: 0.95;
}

.hero-btn {
  background: #ffffff;
  color: #28a745;
  border: none;
  padding: 1rem 2rem;
  font-size: 1rem;
  font-weight: 600;
  border-radius: 50px;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 4px 20px rgba(255, 255, 255, 0.3);
  min-width: 180px;
}

.hero-btn:hover {
  background: #f8f9fa;
  transform: translateY(-2px);
  box-shadow: 0 8px 30px rgba(255, 255, 255, 0.4);
}

/* Hero Info Cards */
.hero-info-cards {
  position: relative;
  z-index: 3;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  background: white;
  margin: 0 2rem 0;
  border-radius: 12px 12px 0 0;
  box-shadow: 0 -8px 32px rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.info-card {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1.5rem 1rem;
  background: white;
  border-right: 1px solid #e2e8f0;
  transition: all 0.3s ease;
}

.info-card:last-child {
  border-right: none;
}

.info-card:hover {
  background: #f8fafb;
  transform: translateY(-2px);
}

.info-icon {
  width: 45px;
  height: 45px;
  background: linear-gradient(135deg, #28a745, #20c997);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 1.1rem;
  flex-shrink: 0;
}

.info-content h4 {
  font-size: 0.9rem;
  color: #1a202c;
  font-weight: 600;
  margin-bottom: 0.25rem;
}

.info-content p {
  font-size: 1rem;
  color: #28a745;
  font-weight: 700;
  margin-bottom: 0.125rem;
}

.info-content span {
  font-size: 0.8rem;
  color: #64748b;
}


.values-title {
  font-size: 3.5rem;
  color: #1a202c;
  font-weight: 700;
  margin-bottom: 1.5rem;
  letter-spacing: -0.02em;
  line-height: 1.2;
}

.values-subtitle {
  font-size: 1.25rem;
  color: #64748b;
  margin-bottom: 5rem;
  font-weight: 400;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
  margin-bottom: 5rem;
}

.values-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 3rem;
  margin-top: 4rem;
}

.value-card {
  background: #ffffff;
  padding: 3rem 2.5rem;
  border-radius: 20px;
  text-align: center;
  border: 1px solid #e2e8f0;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.value-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, #28a745 0%, #20c997 100%);
  transform: scaleX(0);
  transition: transform 0.3s ease;
}

.value-card:hover {
  transform: translateY(-12px);
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
  border-color: #cbd5e0;
}

.value-card:hover::before {
  transform: scaleX(1);
}

.value-icon {
  width: 80px;
  height: 80px;
  margin: 0 auto 2rem;
  background: linear-gradient(135deg, #f7fafc 0%, #edf2f7 100%);
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2rem;
  color: #28a745;
  transition: all 0.3s ease;
}

.value-card:hover .value-icon {
  background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
  color: white;
  transform: scale(1.1);
}

.value-card h4 {
  font-size: 1.5rem;
  color: #1a202c;
  margin-bottom: 1.5rem;
  font-weight: 600;
  letter-spacing: -0.01em;
}

.value-card p {
  color: #64748b;
  line-height: 1.7;
  font-size: 1rem;
  font-weight: 400;
}

/* Choose Tour Section */
.choose-tour-section {
  padding: 6rem 0;
  background: #ffffff;
  position: relative;
}

.tour-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 3rem;
}

.tour-header {
  margin-bottom: 4rem;
  text-align: center;
}

.tour-title {
  font-size: 3.25rem;
  color: #1a202c;
  font-weight: 700;
  margin-bottom: 1rem;
  letter-spacing: -0.02em;
  line-height: 1.2;
}

.tour-subtitle {
  font-size: 1.2rem;
  color: #64748b;
  font-weight: 400;
  max-width: 500px;
  margin: 0 auto;
}

.tour-cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2.5rem;
  margin-bottom: 4rem;
}

.tour-card-item {
  background: #ffffff;
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
  border: 1px solid #f1f5f9;
}

.tour-card-item:hover {
  transform: translateY(-12px) scale(1.02);
  box-shadow: 0 24px 64px rgba(0, 0, 0, 0.15);
  border-color: #e2e8f0;
}

.tour-card-image {
  position: relative;
  height: 220px;
  overflow: hidden;
}

.tour-card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

.tour-card-item:hover .tour-card-image img {
  transform: scale(1.15);
}

.tour-card-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent 0%, rgba(0, 0, 0, 0.4) 40%, rgba(0, 0, 0, 0.8) 100%);
  color: white;
  padding: 2rem;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.tour-info h4 {
  font-size: 1.25rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
  letter-spacing: -0.01em;
}

.tour-price {
  font-size: 1.1rem;
  font-weight: 700;
}

.tour-price small {
  font-size: 0.85rem;
  opacity: 0.9;
  font-weight: 400;
}

.tour-card-btn {
  background: rgba(255, 255, 255, 0.2);
  border: 2px solid rgba(255, 255, 255, 0.3);
  color: white;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  backdrop-filter: blur(20px);
}

.tour-card-btn:hover {
  background: rgba(255, 255, 255, 0.9);
  color: #28a745;
  transform: scale(1.15);
  border-color: rgba(255, 255, 255, 0.9);
}

.see-all-container {
  text-align: center;
  margin-top: 3rem;
}

.see-all-btn {
  background: transparent;
  color: #2c3e50;
  border: 2px solid #e0e0e0;
  padding: 1rem 2rem;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
  transition: all 0.3s ease;
}

.see-all-btn:hover {
  border-color: #28a745;
  color: #28a745;
  transform: translateY(-2px);
}

/* Enjoy Travel Section */
.enjoy-travel-section {
  padding: 4rem 0;
  background: #f8f9fa;
}

.enjoy-travel-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}

.enjoy-content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
  margin-bottom: 4rem;
}

.enjoy-text h2 {
  font-size: 2.5rem;
  color: #2c3e50;
  font-weight: 600;
  margin-bottom: 1.5rem;
}

.enjoy-text p {
  font-size: 1.1rem;
  color: #666;
  line-height: 1.8;
  margin-bottom: 2rem;
}

.discover-btn {
  background: linear-gradient(135deg, #28a745, #20c997);
  color: white;
  border: none;
  padding: 1rem 2rem;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
  transition: all 0.3s ease;
}

.discover-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(40, 167, 69, 0.3);
}

.enjoy-visual {
  display: flex;
  gap: 1rem;
  align-items: center;
}

.main-travel-image {
  flex: 1;
}

.main-travel-image img {
  width: 100%;
  height: 300px;
  object-fit: cover;
  border-radius: 16px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
}

.side-cards {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.travel-card {
  background: white;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  width: 200px;
  transition: transform 0.3s ease;
}

.travel-card:hover {
  transform: translateX(-5px);
}

.travel-card img {
  width: 100%;
  height: 120px;
  object-fit: cover;
}

.card-info {
  padding: 1rem;
}

.card-info h4 {
  font-size: 0.95rem;
  color: #2c3e50;
  margin-bottom: 0.5rem;
  font-weight: 600;
}

.card-price {
  color: #28a745;
  font-weight: 600;
  font-size: 0.9rem;
}

.card-price small {
  font-size: 0.8rem;
  color: #666;
}

/* All Destinations Section */
.all-destinations-section {
  padding: 8rem 0 6rem;
  background: linear-gradient(180deg, #f8fafb 0%, #ffffff 100%);
  position: relative;
}

.all-destinations-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent 0%, #e2e8f0 50%, transparent 100%);
}

.destinations-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 3rem;
}

.destinations-header {
  text-align: center;
  margin-bottom: 5rem;
}

.destinations-title {
  font-size: 3.5rem;
  color: #1a202c;
  font-weight: 700;
  margin-bottom: 1.5rem;
  letter-spacing: -0.02em;
  line-height: 1.2;
}

.destinations-subtitle {
  font-size: 1.25rem;
  color: #64748b;
  margin-bottom: 4rem;
  font-weight: 400;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
  margin-bottom: 4rem;
}

.search-filter-container {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 3rem;
  flex-wrap: wrap;
  margin-bottom: 2rem;
}

.search-bar {
  position: relative;
  background: #ffffff;
  border-radius: 30px;
  padding: 1.25rem 2rem;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  gap: 1rem;
  border: 2px solid #f1f5f9;
  width: 420px;
  max-width: 100%;
  transition: all 0.3s ease;
}

.search-bar:focus-within {
  border-color: #28a745;
  box-shadow: 0 8px 32px rgba(40, 167, 69, 0.15);
}

.search-icon {
  color: #64748b;
  font-size: 1.25rem;
  transition: color 0.3s ease;
}

.search-bar:focus-within .search-icon {
  color: #28a745;
}

.search-bar input {
  flex: 1;
  border: none;
  outline: none;
  font-size: 1.1rem;
  color: #2c3e50;
  background: transparent;
  font-weight: 400;
}

.search-bar input::placeholder {
  color: #94a3b8;
  font-weight: 400;
}

.destination-stats {
  background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
  color: white;
  padding: 1rem 2rem;
  border-radius: 25px;
  font-weight: 600;
  font-size: 1rem;
  box-shadow: 0 4px 16px rgba(40, 167, 69, 0.2);
  border: none;
}

.destinations-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
  gap: 3rem;
  margin-top: 4rem;
}

.destination-card {
  background: #ffffff;
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
  position: relative;
  border: 1px solid #f1f5f9;
}

.destination-card:hover {
  transform: translateY(-16px);
  box-shadow: 0 32px 80px rgba(0, 0, 0, 0.12);
  border-color: #e2e8f0;
}

.card-image {
  position: relative;
  height: 280px;
  overflow: hidden;
}

.card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

.destination-card:hover .card-image img {
  transform: scale(1.1) rotate(1deg);
}

.card-overlay {
  position: absolute;
  top: 1.5rem;
  left: 1.5rem;
}

.card-category {
  background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
  color: white;
  padding: 0.75rem 1.5rem;
  border-radius: 25px;
  font-size: 0.85rem;
  text-transform: uppercase;
  font-weight: 600;
  letter-spacing: 0.5px;
  box-shadow: 0 4px 16px rgba(40, 167, 69, 0.3);
  backdrop-filter: blur(10px);
}

.card-favorite {
  position: absolute;
  top: 1.5rem;
  right: 1.5rem;
  background: rgba(255, 255, 255, 0.95);
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(20px);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.favorite-icon {
  color: #fbbf24;
  font-size: 1.25rem;
  transition: transform 0.3s ease;
}

.card-favorite:hover {
  background: rgba(255, 255, 255, 1);
  transform: scale(1.15);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
}

.card-favorite:hover .favorite-icon {
  transform: scale(1.2);
}

.card-content {
  padding: 2.5rem;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 1.5rem;
  gap: 1rem;
}

.card-header h3 {
  font-size: 1.75rem;
  color: #1a202c;
  font-weight: 700;
  flex: 1;
  line-height: 1.3;
  letter-spacing: -0.01em;
}

.rating {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: linear-gradient(135deg, #f7fafc 0%, #edf2f7 100%);
  padding: 0.75rem 1rem;
  border-radius: 20px;
  border: 1px solid #e2e8f0;
  flex-shrink: 0;
}

.star-icon {
  color: #fbbf24;
  font-size: 1rem;
}

.rating span {
  font-size: 0.95rem;
  color: #4a5568;
  font-weight: 600;
}

.card-description {
  color: #64748b;
  line-height: 1.7;
  margin-bottom: 2rem;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 1.05rem;
  font-weight: 400;
}

.card-details {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
  padding-top: 2rem;
  border-top: 1px solid #f1f5f9;
}

.location {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  color: #64748b;
  font-size: 1rem;
  font-weight: 500;
}

.location-icon {
  color: #28a745;
  font-size: 1.1rem;
}

.price {
  text-align: right;
}

.price-amount {
  font-size: 1.5rem;
  font-weight: 700;
  color: #28a745;
  letter-spacing: -0.01em;
}

.price-period {
  font-size: 0.9rem;
  color: #64748b;
  margin-left: 0.5rem;
  font-weight: 400;
}

.explore-btn {
  width: 100%;
  background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
  color: white;
  border: none;
  padding: 1.25rem 2rem;
  border-radius: 16px;
  cursor: pointer;
  font-weight: 600;
  font-size: 1.1rem;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  position: relative;
  overflow: hidden;
}

.explore-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.6s ease;
}

.explore-btn:hover::before {
  left: 100%;
}

.explore-btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 32px rgba(40, 167, 69, 0.3);
}

.no-results {
  text-align: center;
  padding: 6rem 2rem;
  grid-column: 1 / -1;
}

.no-results h3 {
  font-size: 2rem;
  color: #2d3748;
  margin-bottom: 1rem;
  font-weight: 600;
}

.no-results p {
  color: #64748b;
  font-size: 1.2rem;
  font-weight: 400;
}

.hero-image:hover img {
  transform: scale(1.05);
}

/* Search Container */
.search-container {
  position: absolute;
  bottom: 80px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 3;
}

.search-bar {
  position: relative;
/* Enhanced Modal */
.destination-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  padding: 2rem;
}

.destination-modal {
  background: white;
  border-radius: 16px;
  max-width: 900px;
  max-height: 90vh;
  overflow-y: auto;
  position: relative;
  box-shadow: 0 25px 50px rgba(0, 0, 0, 0.3);
}

.modal-header {
  padding: 2rem;
  border-bottom: 1px solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-title-section h2 {
  font-size: 1.8rem;
  color: #2c3e50;
  margin-bottom: 0.5rem;
  font-weight: 600;
}

.modal-category {
  background: linear-gradient(135deg, #28a745, #20c997);
  color: white;
  padding: 0.4rem 1rem;
  border-radius: 20px;
  font-size: 0.8rem;
  text-transform: uppercase;
  font-weight: 600;
}

.modal-close {
  background: #f8f9fa;
  border: none;
  font-size: 1.5rem;
  color: #666;
  cursor: pointer;
  padding: 0.5rem;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.3s ease;
}

.modal-close:hover {
  background: #e9ecef;
  color: #333;
}

.modal-tabs {
  display: flex;
  border-bottom: 1px solid #f0f0f0;
  padding: 0 2rem;
}

.tab-btn {
  background: none;
  border: none;
  padding: 1rem 1.5rem;
  cursor: pointer;
  font-weight: 500;
  color: #666;
  border-bottom: 3px solid transparent;
  transition: all 0.3s ease;
  font-size: 0.9rem;
}

.tab-btn.active {
  color: #28a745;
  border-bottom-color: #28a745;
}

.tab-btn:hover {
  color: #28a745;
}

.modal-content {
  padding: 2rem;
}

.modal-image {
  width: 100%;
  height: 300px;
  object-fit: cover;
  border-radius: 12px;
  margin-bottom: 1.5rem;
}

.modal-description {
  font-size: 1rem;
  line-height: 1.8;
  color: #666;
  margin-bottom: 2rem;
}

.modal-info-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1rem;
  margin-bottom: 2rem;
}

.modal-info-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem;
  background: #f8f9fa;
  border-radius: 12px;
  border: 1px solid #f0f0f0;
}

.modal-info-icon {
  color: #28a745;
  font-size: 1.3rem;
}

.modal-info-text {
  flex: 1;
}

.modal-info-text strong {
  display: block;
  color: #2c3e50;
  margin-bottom: 0.25rem;
  font-size: 0.9rem;
  font-weight: 600;
}

.travel-options {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1rem;
}

.travel-option {
  background: #f8f9fa;
  padding: 1rem;
  border-radius: 12px;
  border: 1px solid #f0f0f0;
  border-left: 4px solid #28a745;
}

.travel-option h4 {
  color: #2c3e50;
  margin-bottom: 0.5rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.95rem;
  font-weight: 600;
}

.travel-details {
  display: flex;
  justify-content: space-between;
  color: #666;
  font-size: 0.85rem;
}

.map-container {
  background: #f8f9fa;
  padding: 3rem 2rem;
  border-radius: 12px;
  text-align: center;
  color: #666;
  border: 1px solid #f0f0f0;
}

/* Responsive Design */
@media (max-width: 1200px) {
  .destinations-grid {
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }
}

@media (max-width: 968px) {
  .search-filter-container {
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .destinations-grid {
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }
}

@media (max-width: 768px) {
  .values-title,
  .tour-title,
  .destinations-title {
    font-size: 2rem;
  }
  
  .destinations-subtitle {
    font-size: 1rem;
  }
  
  .values-grid {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }
  
  .tour-cards-grid {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }
  
  .destinations-grid {
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  
  .search-bar {
    width: 100%;
    max-width: 350px;
  }
  
  .card-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }
  
  .card-header h3 {
    margin-right: 0;
  }
  
  .card-details {
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }
  
  .price {
    text-align: left;
  }
  
  .modal-tabs {
    flex-wrap: wrap;
    padding: 0 1rem;
  }
  
  .modal-header,
  .modal-content {
    padding: 1.5rem;
  }
  
  .modal-info-grid {
    grid-template-columns: 1fr;
  }
  
  .travel-options {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 480px) {
  .destination-container {
    padding: 1rem 0;
  }
  
  .values-container,
  .tour-container,
  .destinations-container {
    padding: 0 1rem;
  }
  
  .values-title,
  .tour-title,
  .destinations-title {
    font-size: 1.8rem;
  }
  
  .values-grid {
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  
  .tour-cards-grid {
    grid-template-columns: 1fr;
  }
  
  .destinations-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  
  .search-bar {
    width: 100%;
    padding: 0.8rem 1rem;
  }
  
  .destination-stats {
    padding: 0.6rem 1.2rem;
    font-size: 0.85rem;
  }
  
  .card-image {
    height: 200px;
  }
  
  .card-content {
    padding: 1.2rem;
  }
}

/* Tours Section */
.tours-section {
  padding: 5rem 0;
  background: #f8f9fa;
}

.tours-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}

.section-header {
  text-align: center;
  margin-bottom: 4rem;
}

.section-subtitle {
  color: #28a745;
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 2px;
  font-weight: 600;
  margin-bottom: 1rem;
  display: block;
}

.section-title {
  font-size: 3rem;
  color: #2c3e50;
  font-weight: 300;
  font-family: 'Playfair Display', serif;
}

.tours-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 2rem;
}

.tour-card {
  background: white;
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  cursor: pointer;
}

.tour-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
}

.tour-image {
  position: relative;
  height: 250px;
  overflow: hidden;
}

.tour-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.tour-card:hover .tour-image img {
  transform: scale(1.1);
}

.tour-badge {
  position: absolute;
  top: 1rem;
  left: 1rem;
  background: rgba(40, 167, 69, 0.9);
  color: white;
  padding: 0.5rem 1rem;
  border-radius: 20px;
  font-size: 0.8rem;
  text-transform: uppercase;
  font-weight: 600;
}

.tour-price {
  position: absolute;
  top: 1rem;
  right: 1rem;
  background: rgba(0, 0, 0, 0.7);
  color: white;
  padding: 0.5rem 1rem;
  border-radius: 20px;
  font-weight: 600;
}

.tour-content {
  padding: 1.5rem;
}

.tour-location {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: #666;
  font-size: 0.9rem;
  margin-bottom: 1rem;
}

.location-icon {
  color: #28a745;
}

.tour-title {
  font-size: 1.3rem;
  color: #2c3e50;
  margin-bottom: 1rem;
  font-weight: 600;
}

.tour-rating {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
}

.stars {
  color: #ffc107;
  display: flex;
  gap: 2px;
}

.rating-text {
  font-size: 0.9rem;
  color: #666;
}

.tour-btn {
  width: 100%;
  background: transparent;
  color: #28a745;
  border: 2px solid #28a745;
  padding: 0.75rem;
  border-radius: 5px;
  cursor: pointer;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1px;
  transition: all 0.3s ease;
}

.tour-btn:hover {
  background: #28a745;
  color: white;
}

/* Services Section */
.services-section {
  padding: 5rem 0;
  background: white;
}

.services-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 3rem;
}

.service-card {
  text-align: center;
  padding: 2rem;
  border-radius: 10px;
  transition: transform 0.3s ease;
}

.service-card:hover {
  transform: translateY(-5px);
  background: #f8f9fa;
}

.service-icon {
  width: 80px;
  height: 80px;
  margin: 0 auto 1.5rem;
  background: #f8f9fa;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2rem;
  color: #28a745;
  border: 3px solid #e9ecef;
  transition: all 0.3s ease;
}

.service-card:hover .service-icon {
  background: #28a745;
  color: white;
  border-color: #28a745;
}

.service-card h3 {
  font-size: 1.3rem;
  color: #2c3e50;
  margin-bottom: 1rem;
  font-weight: 600;
}

.service-card p {
  color: #666;
  line-height: 1.6;
}

/* Attractions Section */
.attractions-section {
  padding: 5rem 0;
  background: #f8f9fa;
}

.attractions-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
}

.attractions-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
  gap: 2rem;
}

.attraction-card {
  background: white;
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  cursor: pointer;
}

.attraction-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15);
}

.attraction-image {
  height: 200px;
  overflow: hidden;
}

.attraction-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.attraction-card:hover .attraction-image img {
  transform: scale(1.05);
}

.attraction-content {
  padding: 1.5rem;
}

.attraction-content h3 {
  font-size: 1.3rem;
  color: #2c3e50;
  margin-bottom: 0.5rem;
  font-weight: 600;
}

.attraction-content p {
  color: #666;
  line-height: 1.6;
  margin-bottom: 1rem;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.attraction-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.attraction-category {
  background: #e9ecef;
  color: #666;
  padding: 0.3rem 0.8rem;
  border-radius: 15px;
  font-size: 0.8rem;
  text-transform: uppercase;
  font-weight: 600;
}

.attraction-btn {
  background: linear-gradient(135deg, #28a745, #20c997);
  color: white;
  border: none;
  padding: 0.5rem 1rem;
  border-radius: 20px;
  cursor: pointer;
  font-weight: 600;
  font-size: 0.9rem;
  transition: all 0.3s ease;
}

.attraction-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 3px 10px rgba(40, 167, 69, 0.3);
}
  transition: all 0.3s ease;
  background: #ffffff;
  box-shadow: 0 10px 30px rgba(40,167,69,0.1);
  border: 2px solid rgba(40,167,69,0.1);
}

.featured-card:hover {
  transform: translateY(-10px);
  box-shadow: 0 20px 50px rgba(40,167,69,0.2);
  border-color: #28a745;
}

.featured-card-1 {
  grid-column: span 2;
}

.featured-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.featured-card:hover img {
  transform: scale(1.1);
}

.featured-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(40,167,69,0.9));
  color: white;
  padding: 30px 20px 20px;
  transform: translateY(20px);
  transition: transform 0.3s ease;
}

.featured-card:hover .featured-overlay {
  transform: translateY(0);
}

.featured-overlay h3 {
  font-size: 1.3rem;
  font-weight: 600;
  margin-bottom: 5px;
}

.featured-overlay p {
  font-size: 0.9rem;
  opacity: 0.9;
}

/* Bottom Section */
.bottom-section {
  padding: 100px 20px;
  background: linear-gradient(135deg, #ffffff 0%, #f0f9f0 50%, #e8f5e8 100%);
  position: relative;
  overflow: hidden;
}

.bottom-content {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 500px;
  gap: 60px;
  align-items: center;
}

.bottom-text h2 {
  font-size: 3rem;
  color: #28a745;
  line-height: 1.2;
  font-weight: 700;
  margin-bottom: 30px;
  text-shadow: 2px 2px 4px rgba(40,167,69,0.1);
}

.bottom-image {
  position: relative;
  height: 400px;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 20px 50px rgba(40,167,69,0.15);
  border: 3px solid rgba(40,167,69,0.2);
}

.bottom-image img {
  width: 100%;
  height: 60%;
  object-fit: cover;
  border-radius: 15px;
}

.bottom-description {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(135deg, rgba(40,167,69,0.95) 0%, rgba(32,201,151,0.95) 100%);
  backdrop-filter: blur(10px);
  color: white;
  padding: 20px;
  border-radius: 0 0 15px 15px;
}

.bottom-description p {
  font-size: 0.9rem;
  line-height: 1.6;
  opacity: 0.95;
}

/* All Destinations Section */
.all-destinations {
  background: linear-gradient(135deg, #ffffff 0%, #f8fff8 50%, #f0f9f0 100%);
  padding: 100px 20px;
}

.section-header {
  text-align: center;
  margin-bottom: 60px;
}

.section-header h2 {
  font-size: 3rem;
  color: #28a745;
  margin-bottom: 15px;
  font-weight: 700;
  text-shadow: 2px 2px 4px rgba(40,167,69,0.1);
}

.section-header p {
  font-size: 1.2rem;
  color: #666;
  max-width: 600px;
  margin: 0 auto;
}

/* Grid Layout */
.destinations-grid {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
  gap: 30px;
}

/* Cards */
.destination-card {
  background: white;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(40,167,69,0.1);
  transition: all 0.4s ease;
  border: 2px solid rgba(40,167,69,0.1);
  position: relative;
}

.destination-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, transparent 0%, rgba(40, 167, 69, 0.05) 100%);
  opacity: 0;
  transition: opacity 0.3s ease;
  z-index: 1;
}

.destination-card:hover::before {
  opacity: 1;
}

.destination-card:hover {
  transform: translateY(-15px) scale(1.02);
  box-shadow: 0 20px 60px rgba(40,167,69,0.15);
  border-color: #28a745;
}

/* Card Image */
.card-image-container {
  position: relative;
  overflow: hidden;
  height: 250px;
}

.destination-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.destination-card:hover .destination-image {
  transform: scale(1.1);
}

.category-tag {
  position: absolute;
  top: 20px;
  right: 20px;
  background: linear-gradient(135deg, #28a745, #20c997);
  color: white;
  padding: 8px 16px;
  border-radius: 25px;
  font-size: 0.8rem;
  font-weight: 600;
  backdrop-filter: blur(10px);
  box-shadow: 0 4px 15px rgba(40, 167, 69, 0.3);
}

.distance-tag {
  position: absolute;
  top: 20px;
  left: 20px;
  background: rgba(255, 255, 255, 0.95);
  color: #28a745;
  padding: 8px 16px;
  border-radius: 20px;
  font-size: 0.8rem;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 8px;
  backdrop-filter: blur(10px);
  border: 1px solid rgba(40,167,69,0.3);
}

/* Card Content */
.card-content {
  padding: 30px;
  position: relative;
  z-index: 2;
}

.destination-title {
  font-size: 1.4rem;
  color: #28a745;
  margin-bottom: 15px;
  font-weight: 700;
  line-height: 1.3;
}

.destination-description {
  color: #666;
  font-size: 1rem;
  line-height: 1.7;
  margin-bottom: 25px;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 25px;
  padding: 15px;
  background: linear-gradient(135deg, #f8fff8 0%, #f0f9f0 100%);
  border-radius: 12px;
  border: 1px solid rgba(40,167,69,0.2);
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.9rem;
  color: #555;
  font-weight: 500;
}

.meta-item svg {
  color: #28a745;
  font-size: 1rem;
}

/* Highlights */
.highlights {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 25px;
}

.highlight-tag {
  background: linear-gradient(135deg, rgba(40, 167, 69, 0.1) 0%, rgba(32, 201, 151, 0.1) 100%);
  color: #28a745;
  padding: 6px 12px;
  border-radius: 15px;
  font-size: 0.8rem;
  font-weight: 600;
  border: 1px solid rgba(40, 167, 69, 0.2);
  transition: all 0.3s ease;
}

.highlight-tag:hover {
  background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
  color: white;
  transform: translateY(-2px);
  box-shadow: 0 4px 15px rgba(40,167,69,0.3);
}

/* Card Actions */
.card-actions {
  display: flex;
  gap: 12px;
}

.btn-primary, .btn-secondary {
  flex: 1;
  padding: 12px 20px;
  border-radius: 12px;
  font-weight: 600;
  font-size: 0.9rem;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  text-decoration: none;
  border: none;
  position: relative;
  overflow: hidden;
}

.btn-primary {
  background: linear-gradient(135deg, #28a745, #20c997);
  color: white;
  box-shadow: 0 4px 15px rgba(40, 167, 69, 0.3);
}

.btn-primary::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
  transition: left 0.5s ease;
}

.btn-primary:hover::before {
  left: 100%;
}

.btn-primary:hover {
  background: linear-gradient(135deg, #218838, #17a2b8);
  transform: translateY(-3px);
  box-shadow: 0 8px 25px rgba(40, 167, 69, 0.4);
}

.btn-secondary {
  background: white;
  color: #28a745;
  border: 2px solid #28a745;
  box-shadow: 0 4px 15px rgba(40,167,69,0.1);
}

.btn-secondary:hover {
  background: #28a745;
  color: white;
  transform: translateY(-3px);
  box-shadow: 0 8px 25px rgba(40, 167, 69, 0.3);
}

/* Modal Styles */
.destination-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(40, 167, 69, 0.1);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 20px;
}

.destination-modal {
  background: white;
  border-radius: 25px;
  max-width: 900px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: 0 25px 80px rgba(40,167,69,0.2);
  border: 2px solid rgba(40,167,69,0.1);
  position: relative;
}

.modal-header {
  padding: 40px;
  border-bottom: 2px solid rgba(40,167,69,0.1);
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  background: linear-gradient(135deg, #f8fff8 0%, #f0f9f0 100%);
  border-radius: 25px 25px 0 0;
}

.modal-title-section h2 {
  font-size: 2rem;
  color: #28a745;
  margin-bottom: 10px;
  font-weight: 700;
}

.modal-category {
  background: linear-gradient(135deg, #28a745, #20c997);
  color: white;
  padding: 6px 16px;
  border-radius: 20px;
  font-size: 0.9rem;
  font-weight: 600;
}

.modal-close {
  background: none;
  border: none;
  font-size: 2.5rem;
  cursor: pointer;
  color: #28a745;
  padding: 5px;
  line-height: 1;
  transition: all 0.3s ease;
  border-radius: 50%;
  width: 50px;
  height: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-close:hover {
  color: #ffffff;
  background: #28a745;
}

.modal-tabs {
  padding: 0 40px;
  border-bottom: 2px solid rgba(40,167,69,0.1);
  display: flex;
  gap: 0;
  background: white;
}

.tab-btn {
  background: none;
  border: none;
  padding: 20px 25px;
  cursor: pointer;
  font-weight: 600;
  color: #666;
  border-bottom: 3px solid transparent;
  transition: all 0.3s ease;
  font-size: 1rem;
}

.tab-btn.active {
  color: #28a745;
  border-bottom-color: #28a745;
}

.tab-btn:hover {
  color: #28a745;
  background: rgba(40, 167, 69, 0.05);
}

.modal-content {
  padding: 40px;
}

.modal-image {
  width: 100%;
  height: 350px;
  object-fit: cover;
  border-radius: 20px;
  margin-bottom: 25px;
  box-shadow: 0 10px 30px rgba(40,167,69,0.1);
  border: 2px solid rgba(40,167,69,0.1);
}

.modal-description {
  font-size: 1.1rem;
  line-height: 1.8;
  color: #555;
  margin-bottom: 30px;
}

.modal-info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 30px;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 15px;
  padding: 20px;
  background: linear-gradient(135deg, #f8fff8 0%, #f0f9f0 100%);
  border-radius: 15px;
  border: 1px solid rgba(40,167,69,0.2);
  transition: all 0.3s ease;
}

.info-item:hover {
  transform: translateY(-2px);
  box-shadow: 0 5px 15px rgba(40,167,69,0.1);
  border-color: #28a745;
}

.info-item svg {
  color: #28a745;
  font-size: 1.4rem;
}

.info-text strong {
  display: block;
  font-weight: 700;
  color: #28a745;
  font-size: 1rem;
}

.info-text span {
  color: #666;
  font-size: 0.95rem;
}

/* Responsive Design */
@media (max-width: 1024px) {
  .hero-content {
    grid-template-columns: 1fr;
    gap: 40px;
    text-align: center;
  }
  
  .hero-text h1.hero-title {
    font-size: 3.5rem;
  }
  
  .featured-grid {
    grid-template-columns: 1fr 1fr;
    height: auto;
  }
  
  .featured-card-1 {
    grid-column: span 2;
    height: 300px;
  }
  
  .featured-card {
    height: 250px;
  }
  
  .bottom-content {
    grid-template-columns: 1fr;
    gap: 40px;
    text-align: center;
  }
}

@media (max-width: 768px) {
  .hero-section {
    height: 80vh;
    padding: 0 15px;
  }
  
  .hero-text h1.hero-title {
    font-size: 2.5rem;
  }
  
  .search-bar {
    width: 350px;
  }
  
  .featured-grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }
  
  .featured-card-1, .featured-card {
    height: 250px;
    grid-column: span 1;
  }
  
  .bottom-text h2 {
/* Enhanced Modal */
.destination-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  padding: 2rem;
}

.destination-modal {
  background: white;
  border-radius: 15px;
  max-width: 900px;
  max-height: 90vh;
  overflow-y: auto;
  position: relative;
  box-shadow: 0 25px 50px rgba(0, 0, 0, 0.3);
}

.modal-header {
  padding: 2rem;
  border-bottom: 1px solid #eee;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-title-section h2 {
  font-size: 2rem;
  color: #2c3e50;
  margin-bottom: 0.5rem;
}

.modal-category {
  background: #28a745;
  color: white;
  padding: 0.3rem 1rem;
  border-radius: 15px;
  font-size: 0.8rem;
  text-transform: uppercase;
  font-weight: 600;
}

.modal-close {
  background: none;
  border: none;
  font-size: 2rem;
  color: #999;
  cursor: pointer;
  padding: 0;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.3s ease;
}

.modal-close:hover {
  background: #f8f9fa;
  color: #666;
}

.modal-tabs {
  display: flex;
  border-bottom: 1px solid #eee;
  padding: 0 2rem;
}

.tab-btn {
  background: none;
  border: none;
  padding: 1rem 1.5rem;
  cursor: pointer;
  font-weight: 600;
  color: #666;
  border-bottom: 3px solid transparent;
  transition: all 0.3s ease;
}

.tab-btn.active {
  color: #28a745;
  border-bottom-color: #28a745;
}

.tab-btn:hover {
  color: #28a745;
}

.modal-content {
  padding: 2rem;
}

.modal-image {
  width: 100%;
  height: 300px;
  object-fit: cover;
  border-radius: 10px;
  margin-bottom: 1.5rem;
}

.modal-description {
  font-size: 1.1rem;
  line-height: 1.8;
  color: #666;
  margin-bottom: 2rem;
}

.modal-info-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.modal-info-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem;
  background: #f8f9fa;
  border-radius: 10px;
}

.modal-info-icon {
  color: #28a745;
  font-size: 1.5rem;
}

.modal-info-text {
  flex: 1;
}

.modal-info-text strong {
  display: block;
  color: #2c3e50;
  margin-bottom: 0.25rem;
}

.travel-options {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1rem;
}

.travel-option {
  background: #f8f9fa;
  padding: 1rem;
  border-radius: 10px;
  border-left: 4px solid #28a745;
}

.travel-option h4 {
  color: #2c3e50;
  margin-bottom: 0.5rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.travel-details {
  display: flex;
  justify-content: space-between;
  color: #666;
  font-size: 0.9rem;
}

.map-container {
  background: #f8f9fa;
  padding: 2rem;
  border-radius: 10px;
  text-align: center;
  color: #666;
}

/* Responsive Design */
@media (max-width: 1200px) {
  .hero-content {
    padding: 0 2rem;
  }
  
  .hero-info-cards {
    margin: 0 2rem 0;
  }
  
  .destinations-grid {
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2.5rem;
  }
  
  .values-container,
  .tour-container,
  .destinations-container {
    padding: 0 2rem;
  }
}

@media (max-width: 968px) {
  .hero-info-cards {
    grid-template-columns: repeat(2, 1fr);
    margin: 0 1.5rem 0;
  }
  
  .hero-title {
    font-size: 3.5rem;
  }
  
  .hero-description {
    font-size: 1.1rem;
  }
  
  .search-filter-container {
    flex-direction: column;
    gap: 2rem;
  }
  
  .destinations-grid {
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }
  
  .values-section {
    padding: 6rem 0 4rem;
  }
  
  .choose-tour-section {
    padding: 5rem 0;
  }
  
  .all-destinations-section {
    padding: 6rem 0 4rem;
  }
}

@media (max-width: 768px) {
  .hero-content {
    padding: 0 1.5rem;
  }
  
  .hero-info-cards {
    grid-template-columns: 1fr;
    margin: 0 1.5rem 0;
  }
  
  .info-card {
    border-right: none;
    border-bottom: 1px solid #f1f5f9;
  }
  
  .info-card:last-child {
    border-bottom: none;
  }
  
  .hero-title {
    font-size: 3rem;
  }
  
  .hero-description {
    font-size: 1rem;
    margin-bottom: 2rem;
  }
  
  .hero-btn {
    padding: 1rem 2rem;
  }
  
  .values-title,
  .tour-title,
  .destinations-title {
    font-size: 2.75rem;
    margin-bottom: 1rem;
  }
  
  .destinations-subtitle,
  .values-subtitle,
  .tour-subtitle {
    font-size: 1.1rem;
    margin-bottom: 3rem;
  }
  
  .values-grid {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2rem;
  }
  
  .tour-cards-grid {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }
  
  .destinations-grid {
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }
  
  .search-bar {
    width: 100%;
    max-width: 380px;
    padding: 1rem 1.5rem;
  }
  
  .card-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  
  .card-header h3 {
    margin-right: 0;
    font-size: 1.5rem;
  }
  
  .card-details {
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }
  
  .price {
    text-align: left;
  }
  
  .value-card {
    padding: 2.5rem 2rem;
  }
  
  .card-content {
    padding: 2rem;
  }
  
  .values-section,
  .choose-tour-section,
  .all-destinations-section {
    padding: 5rem 0 3rem;
  }
  
  .modal-tabs {
    flex-wrap: wrap;
    padding: 0 1rem;
  }
  
  .modal-header,
  .modal-content {
    padding: 1.5rem;
  }
  
  .modal-info-grid {
    grid-template-columns: 1fr;
  }
  
  .travel-options {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 480px) {
  .hero-section {
    height: 90vh;
  }
  
  .hero-content {
    padding: 0 1rem;
  }
  
  .hero-info-cards {
    margin: 0 1rem 0;
  }
  
  .info-card {
    padding: 1.5rem 1rem;
    gap: 1rem;
  }
  
  .info-icon {
    width: 40px;
    height: 40px;
    font-size: 1.1rem;
  }
  
  .hero-title {
    font-size: 2.5rem;
  }
  
  .hero-description {
    font-size: 0.95rem;
  }
  
  .destination-container {
    padding: 0;
  }
  
  .values-container,
  .tour-container,
  .destinations-container {
    padding: 0 1.5rem;
  }
  
  .values-title,
  .tour-title,
  .destinations-title {
    font-size: 2.25rem;
    line-height: 1.1;
  }
  
  .values-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  
  .tour-cards-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  
  .destinations-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  
  .search-bar {
    width: 100%;
    padding: 1rem 1.25rem;
  }
  
  .destination-stats {
    padding: 0.875rem 1.5rem;
    font-size: 0.9rem;
  }
  
  .card-image {
    height: 240px;
  }
  
  .card-content {
    padding: 1.75rem;
  }
  
  .value-card {
    padding: 2rem 1.5rem;
  }
  
  .value-icon {
    width: 70px;
    height: 70px;
    font-size: 1.75rem;
  }
  
  .tour-card-image {
    height: 200px;
  }
  
  .explore-btn {
    padding: 1.125rem 1.5rem;
    font-size: 1rem;
  }
  
  .values-section,
  .choose-tour-section,
  .all-destinations-section {
    padding: 4rem 0 2.5rem;
  }
  
  .destinations-header {
    margin-bottom: 3rem;
  }
}
  }
}